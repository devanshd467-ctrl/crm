# Copy to .env for a private workspace. Store real secrets in a deployment secret manager.
# Never point demo mode at your private database.
CRM_DEMO_MODE=false
CRM_DB=.crm-data/production.sqlite
PORT=5173
# Required ONLY for the initial private administrator. No default password is provided.
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
# Optional: enable normalized inbound adapter events with a random secret of 32+ characters.
CRM_WEBHOOK_SECRET=
