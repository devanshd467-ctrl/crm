{
  "name": "bull-realty-global-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "migration:inspect": "node scripts/inspect-workbook.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.js",
    "format": "prettier --write src server tests scripts vite.config.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "express": "^5.1.0",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.6.2",
    "vite": "^7.2.0"
  }
}
